    { "id": "make_toy",       "inputs": [ { "item": "plastic", "count": 1 }, { "item": "plank", "count": 1 } ], "outputs": [ { "item": "toy", "count": 1 } ], "ticks": 30, "valueMultiplier": 2.5 },
