// Base content pack. Everything here is data: tweak numbers, add machines that
// reuse existing behaviors, or layer another pack on top (later packs override by id).
//
// Units: 20 ticks = 1 second. Conveyor tile = 1000 units.
// Ports: "side" is relative to the building facing north; "cell" is a footprint cell.
// Buildings: "tier" gates unlocking; "group"/"replaces" control placing on top of other
// buildings (a splitter can be dropped into a belt line, a belt never replaces a machine);
// "upgrade" overrides the level track of the building's behavior ("levelTracks" below); "limit" caps how
// many can be built (base, plus perTier for every "every" tiers unlocked after the building's own).
// Items marked "raw" sell at a quarter of their value: processing is what pays. Every ore is worth
// about the same ($1), so what an item is worth comes from the work in it: a recipe's output is worth
// what went in times its valueMultiplier. Later goods need many different parts in larger amounts,
// so the old lines stay needed: nothing is replaced by a newer tier, it is built on top.
// Every building is levelled on its own; the only global upgrades are the research trial's (below).
// "meta" is ignored by the simulation; frontends use it:
//   model   procedural 3D model in the Godot client; accent = highlight colour
//   glyph   ASCII view; description = build menu text; items: color + shape (mesh).
{
  // Money a new game starts with: a first drill, belt, smelter and depot line, with a little to spare.
  "startingMoney": 250,

  // The game's length knob. Every amount of money below except what goods are worth is multiplied
  // by this: building prices (and so upgrades), tier prices and required earnings, land, research,
  // the starting money and goal rewards. Income stays the same, so the whole game takes this many
  // times as long (2 = twice as long). A pack on top can set its own.
  "priceScale": 1,

  // The land: a grid of square plots. You start with one (column 2, row 4: the middle of the south
  // edge) and buy the rest, always one that shares an edge with your land. A plot next to the start
  // costs plotPrice, and every further step away from the start multiplies that by priceGrowth, so
  // plots the same distance out cost the same. Depots stand on the outer border of the whole map.
  "map": { "plotSize": 15, "columns": 5, "rows": 5, "startColumn": 2, "startRow": 4, "plotPrice": 1000, "priceGrowth": 22 },

  // How buildings level up, by behavior (a building's own "upgrade" wins; a behavior left out keeps
  // its built-in track). The first upgrade costs the building's price × costFactor, every further
  // one × costGrowth, and costGrowthStep is added to that multiple at every level, so the steps get
  // steeper. Speed and value add per level above 1. Machine and drill levels are the main lever on
  // the game's length: cheaper ones let a good player skip through the tiers (4.28.0 took 3h 18m
  // with ×1.7 and ×1.65), so check `balance tiers --payback 30` after changing them. Depots and
  // export terminals have no top level: every level is a steeper step (×1.9, ×2.0, ×2.1 ...).
  "levelTracks": {
    "processor": { "maxLevel": 25, "speedPerLevel": 0.35, "valuePerLevel": 0.04, "costFactor": 2, "costGrowth": 2.2 },
    "miner":     { "maxLevel": 25, "speedPerLevel": 0.5, "costFactor": 2, "costGrowth": 2.5 },
    "seller":    { "maxLevel": null, "valuePerLevel": 0.1, "costFactor": 2, "costGrowth": 1.9, "costGrowthStep": 0.1 }
  },

  // A tier opens when lifetime earnings and the goods it asks for ("deliver": units sold at depots,
  // totals over the whole game) are both there, and it is paid for. The goods are what the tier
  // before makes, so a factory has to actually run its parts, not only earn.
  // "valueBoost" multiplies what the tier's own new goods are worth (every recipe that makes an item
  // first made in this tier; older items keep their value, even from this tier's bulk machines). It
  // compounds down the chain, since later goods are built from boosted parts, so each tier's main
  // product earns several times the last one's and the numbers grow big.
  "tiers": [
    { "name": "Basics",         "description": "Drill, smelt, sell.",                                             "cost": 0,     "requiredEarnings": 0 },
    { "name": "Workshop",       "description": "Copper, wood, chairs, presses and polishers.",                    "cost": 900,   "requiredEarnings": 1350 },
    { "name": "Industry",       "description": "Coal, steel, sand, glass, gears, screws, crates and lanterns.",   "cost": 2e4,   "requiredEarnings": 3.3e4,
      "deliver": [ { "item": "iron_plate", "count": 150 }, { "item": "copper_wire", "count": 150 } ] },
    { "name": "Petrochemicals", "description": "Oil, plastic, cables, frames, tires, toys, kettles and export terminals.", "cost": 4.4e5, "requiredEarnings": 8.2e5,
      "deliver": [ { "item": "steel", "count": 150 }, { "item": "crate", "count": 60 } ] },
    { "name": "Electronics",    "description": "Gold, circuits, batteries, motors, phones, jewelry, televisions and bulk machines.", "cost": 1.1e7, "requiredEarnings": 2.8e7, "valueBoost": 1.15,
      "deliver": [ { "item": "toy", "count": 80 }, { "item": "frame", "count": 60 } ] },
    { "name": "Robotics",       "description": "Robots from a toy body, motors and circuits, cars and washing machines.",           "cost": 1.4e8, "requiredEarnings": 3.5e8, "valueBoost": 1.85,
      "deliver": [ { "item": "motor", "count": 60 }, { "item": "jewelry", "count": 40 } ] },
    { "name": "Aerospace",      "description": "Bauxite, aluminium, drones, airliners and e-bikes.",                       "cost": 2.1e9, "requiredEarnings": 5.2e9, "valueBoost": 3.7,
      "deliver": [ { "item": "robot", "count": 40 } ] },
    { "name": "Space",          "description": "Rocket fuel and satellites.",                                     "cost": 2.1e10,  "requiredEarnings": 5.3e10, "valueBoost": 1.55,
      "deliver": [ { "item": "drone", "count": 30 } ] },
    // Orbital tier (content drop, 4.13.0): delete every entry marked "Orbital tier" to remove it.
    { "name": "Orbital",        "description": "Titanium, solar panels, habitat modules and orbital stations.",  "cost": 1.55e11, "requiredEarnings": 3.9e11, "valueBoost": 3.8,
      "deliver": [ { "item": "satellite", "count": 25 } ] },
    // Fusion tier (content drop, 4.25.0): delete every entry marked "Fusion tier" to remove it.
    { "name": "Fusion",         "description": "Lithium brine, superconductors, fusion cells and starships.",    "cost": 1.1e12, "requiredEarnings": 2.8e12, "valueBoost": 4,
      "deliver": [ { "item": "orbital_station", "count": 10 } ] }
  ],

  // Every ore is worth the same $1. Nothing else has a base value: it all comes from processing.
  "items": [
    { "id": "iron_ore",     "name": "Iron Ore",     "baseValue": 1, "raw": true, "meta": { "color": "#7c7470", "shape": "rock" } },
    { "id": "copper_ore",   "name": "Copper Ore",   "baseValue": 1, "raw": true, "meta": { "color": "#d9773a", "shape": "rock" } },
    { "id": "coal",         "name": "Coal",         "baseValue": 1, "raw": true, "meta": { "color": "#34343a", "shape": "rock" } },
    { "id": "log",          "name": "Log",          "baseValue": 1, "raw": true, "meta": { "color": "#8a5a33", "shape": "log" } },
    { "id": "sand",         "name": "Sand",         "baseValue": 1, "raw": true, "meta": { "color": "#e4cc92", "shape": "pile" } },
    { "id": "crude_oil",    "name": "Crude Oil",    "baseValue": 1, "raw": true, "meta": { "color": "#2c2838", "shape": "barrel" } },
    { "id": "gold_ore",     "name": "Gold Ore",     "baseValue": 1, "raw": true, "meta": { "color": "#e8c547", "shape": "rock" } },
    { "id": "bauxite",      "name": "Bauxite",      "baseValue": 1, "raw": true, "meta": { "color": "#b5613f", "shape": "rock" } },
    { "id": "iron_ingot",   "name": "Iron Ingot",   "baseValue": 0,               "meta": { "color": "#dfe6ee", "shape": "ingot" } },
    { "id": "copper_ingot", "name": "Copper Ingot", "baseValue": 0,               "meta": { "color": "#e8905a", "shape": "ingot" } },
    { "id": "gold_ingot",   "name": "Gold Ingot",   "baseValue": 0,               "meta": { "color": "#f6cf4a", "shape": "ingot" } },
    { "id": "plank",        "name": "Plank",        "baseValue": 0,               "meta": { "color": "#dcb57e", "shape": "plank" } },
    { "id": "iron_plate",   "name": "Iron Plate",   "baseValue": 0,               "meta": { "color": "#b9c4d0", "shape": "plate" } },
    { "id": "iron_rod",     "name": "Iron Rod",     "baseValue": 0,               "meta": { "color": "#aab5c3", "shape": "rod" } },
    { "id": "screw",        "name": "Screw",        "baseValue": 0,               "meta": { "color": "#cdd2d9", "shape": "screw" } },
    { "id": "gear",         "name": "Gear",         "baseValue": 0,               "meta": { "color": "#8f98a6", "shape": "gear" } },
    { "id": "copper_wire",  "name": "Copper Wire",  "baseValue": 0,               "meta": { "color": "#e8894a", "shape": "coil" } },
    { "id": "steel",        "name": "Steel Beam",   "baseValue": 0,               "meta": { "color": "#7d8fa8", "shape": "ingot" } },
    { "id": "glass",        "name": "Glass",        "baseValue": 0,               "meta": { "color": "#a8e2f7", "shape": "pane" } },
    { "id": "plastic",      "name": "Plastic",      "baseValue": 0,               "meta": { "color": "#5fd3e0", "shape": "plate" } },
    { "id": "cable",        "name": "Cable",        "baseValue": 0,               "meta": { "color": "#4a5468", "shape": "coil" } },
    { "id": "frame",        "name": "Frame",        "baseValue": 0,               "meta": { "color": "#6f819a", "shape": "frame" } },
    { "id": "crate",        "name": "Crate",        "baseValue": 0,               "meta": { "color": "#b98a52", "shape": "box" } },
    { "id": "toy",          "name": "Toy",          "baseValue": 0,               "meta": { "color": "#ff5a6a", "shape": "toy" } },
    { "id": "circuit",      "name": "Circuit Board","baseValue": 0,               "meta": { "color": "#3fbf6a", "shape": "chip" } },
    { "id": "battery",      "name": "Battery",      "baseValue": 0,               "meta": { "color": "#d7e04a", "shape": "battery" } },
    { "id": "motor",        "name": "Motor",        "baseValue": 0,               "meta": { "color": "#9aa6b4", "shape": "motor" } },
    { "id": "jewelry",      "name": "Jewelry",      "baseValue": 0,               "meta": { "color": "#b86bff", "shape": "gem" } },
    { "id": "robot",        "name": "Robot",        "baseValue": 0,               "meta": { "color": "#f2f4f7", "shape": "robot" } },
    { "id": "aluminium",    "name": "Aluminium",    "baseValue": 0,               "meta": { "color": "#c9d3dc", "shape": "ingot" } },
    { "id": "drone",        "name": "Drone",        "baseValue": 0,               "meta": { "color": "#ffb13b", "shape": "drone" } },
    { "id": "rocket_fuel",  "name": "Rocket Fuel",  "baseValue": 0,               "meta": { "color": "#8ae05a", "shape": "barrel" } },
    { "id": "satellite",    "name": "Satellite",    "baseValue": 0,               "meta": { "color": "#dfe8f2", "shape": "satellite" } },
    // Deep-space probes (content drop, 4.6.0): delete every entry marked "Deep-space probes" to remove it.
    { "id": "space_probe",  "name": "Deep-Space Probe", "baseValue": 0,             "meta": { "color": "#77c8ff", "shape": "space_probe" } },
    // Orbital tier (content drop, 4.13.0): a ninth tier after Space. A new ore, one metal from it, a panel
    // and a module from parts the factory already makes, and a station at the end of the line.
    { "id": "titanium_ore", "name": "Titanium Ore", "baseValue": 1, "raw": true, "meta": { "color": "#8e9bab", "shape": "rock" } },
    { "id": "titanium",     "name": "Titanium",     "baseValue": 0,               "meta": { "color": "#b8c4d4", "shape": "ingot" } },
    { "id": "solar_panel",  "name": "Solar Panel",  "baseValue": 0,               "meta": { "color": "#2f4f9e", "shape": "solar_panel" } },
    { "id": "habitat_module", "name": "Habitat Module", "baseValue": 0,           "meta": { "color": "#e6ebf2", "shape": "module" } },
    { "id": "orbital_station", "name": "Orbital Station", "baseValue": 0,         "meta": { "color": "#cfd9e6", "shape": "station" } },
    // Fusion tier (content drop, 4.25.0): a tenth tier after Orbital. Brine pumped from the ground, lithium from
    // it, superconductors from gold, titanium and cable, fusion cells, and a starship built around a station.
    { "id": "lithium_brine", "name": "Lithium Brine", "baseValue": 1, "raw": true, "meta": { "color": "#6fd6c8", "shape": "barrel" } },
    { "id": "lithium",      "name": "Lithium",      "baseValue": 0,               "meta": { "color": "#e3d7ea", "shape": "ingot" } },
    { "id": "superconductor", "name": "Superconductor", "baseValue": 0,           "meta": { "color": "#4f7dff", "shape": "coil" } },
    { "id": "fusion_cell",  "name": "Fusion Cell",  "baseValue": 0,               "meta": { "color": "#ff9a3c", "shape": "fusion_cell" } },
    { "id": "starship",     "name": "Starship",     "baseValue": 0,               "meta": { "color": "#dde4ee", "shape": "starship" } },
    // Byproduct trial (see "Byproducts" in docs/ARCHITECTURE.md): tar comes out of cracking crude oil
    // next to plastic, and a blast furnace burns it instead of coal. "byproduct" keeps it out of orders.
    { "id": "tar",          "name": "Tar",          "baseValue": 0, "byproduct": true, "meta": { "color": "#1c1814", "shape": "pile" } },

    // Research trial slice 1 (see "Research" in docs/ARCHITECTURE.md): a pack is made from parts, a lab
    // banks it, and the bank buys the upgrades below. Nothing needs research. "science" keeps packs out
    // of orders. Remove both marked slices, the Science Bench and the Lab to remove all research content.
    { "id": "science_1",    "name": "Basic Science Pack", "baseValue": 0, "science": true, "meta": { "color": "#8f7cff", "shape": "flask" } },

    // Research slice 2 (4.4.0): the higher pack continues the optional flat research list at Industry.
    // Delete every entry marked "Research slice 2" and remove pack_2 from the Science Bench to drop it.
    { "id": "science_2",    "name": "Advanced Science Pack", "baseValue": 0, "science": true, "meta": { "color": "#43c6e8", "shape": "flask" } },

    // Industrial exports (content drop, 4.7.0): optional mid-game products from existing parts.
    // Delete every entry marked "Industrial exports" to remove the drop.
    { "id": "toolkit",      "name": "Industrial Toolkit", "baseValue": 0,            "meta": { "color": "#e8a84c", "shape": "toolkit" } },
    { "id": "industrial_pump", "name": "Industrial Pump", "baseValue": 0,            "meta": { "color": "#4eb6c8", "shape": "pump" } },

    // Consumer goods (content drop, 4.3.0): an optional side line with one product a tier, built from the
    // parts the main line already makes, so each tier has a second thing worth selling. Its parts feed
    // each other: chairs and tires go into cars, phones into airliners; lanterns are only sold. To remove
    // it, delete every entry marked "Consumer goods" (items, recipes, buildings, goals) and put the tier
    // descriptions back; nothing else refers to them.
    { "id": "chair",        "name": "Chair",        "baseValue": 0,               "meta": { "color": "#c8925a", "shape": "chair" } },
    { "id": "lantern",      "name": "Lantern",      "baseValue": 0,               "meta": { "color": "#ffc94a", "shape": "lantern" } },
    { "id": "tire",         "name": "Tire",         "baseValue": 0,               "meta": { "color": "#3a3a42", "shape": "tire" } },
    { "id": "phone",        "name": "Phone",        "baseValue": 0,               "meta": { "color": "#4a6cf0", "shape": "phone" } },
    { "id": "car",          "name": "Car",          "baseValue": 0,               "meta": { "color": "#3fa7d6", "shape": "car" } },
    { "id": "airliner",     "name": "Airliner",     "baseValue": 0,               "meta": { "color": "#eef3f8", "shape": "plane" } },

    // Home appliances (content drop, 4.24.0): a second side line, one product and one machine a tier from
    // Petrochemicals to Aerospace, from main-line parts only. Each is only sold. Delete every entry marked
    // "Home appliances" (items, recipes, buildings, goals) to remove it; nothing else refers to them.
    { "id": "kettle",       "name": "Electric Kettle", "baseValue": 0,            "meta": { "color": "#e9eef2", "shape": "kettle" } },
    { "id": "television",   "name": "Television",   "baseValue": 0,               "meta": { "color": "#2a2f3a", "shape": "tv" } },
    { "id": "washing_machine", "name": "Washing Machine", "baseValue": 0,         "meta": { "color": "#f4f6f8", "shape": "washer" } },
    { "id": "ebike",        "name": "E-Bike",       "baseValue": 0,               "meta": { "color": "#2fbf8f", "shape": "bike" } },

    // Late exports (content drop, 4.26.0): one optional product and machine for each of the last three tiers
    // (Space, Orbital, Fusion), from main-line parts only, each only sold. Delete every entry marked "Late
    // exports" to remove it. The space suit and maglev go with the Orbital and Fusion tiers if those are removed.
    { "id": "rover",        "name": "Planetary Rover", "baseValue": 0,            "meta": { "color": "#d9a066", "shape": "rover" } },
    { "id": "space_suit",   "name": "Space Suit",   "baseValue": 0,               "meta": { "color": "#f2f2ee", "shape": "suit" } },
    { "id": "maglev",       "name": "Maglev Train", "baseValue": 0,               "meta": { "color": "#c8d4e6", "shape": "maglev" } }
  ],

  "recipes": [
    // Tier 0-1: metal, wood and the first parts
    { "id": "smelt_iron", "inputs": [ { "item": "iron_ore", "count": 1 } ], "outputs": [ { "item": "iron_ingot", "count": 1 } ], "ticks": 16, "valueMultiplier": 2 },
    { "id": "smelt_copper", "inputs": [ { "item": "copper_ore", "count": 1 } ], "outputs": [ { "item": "copper_ingot", "count": 1 } ], "ticks": 16, "valueMultiplier": 2 },
    { "id": "saw_planks", "inputs": [ { "item": "log", "count": 1 } ], "outputs": [ { "item": "plank", "count": 2 } ], "ticks": 20, "valueMultiplier": 1.8 },
    { "id": "press_plate", "inputs": [ { "item": "iron_ingot", "count": 1 } ], "outputs": [ { "item": "iron_plate", "count": 1 } ], "ticks": 16, "valueMultiplier": 2 },
    { "id": "draw_wire", "inputs": [ { "item": "copper_ingot", "count": 1 } ], "outputs": [ { "item": "copper_wire", "count": 2 } ], "ticks": 16, "valueMultiplier": 2 },
    // Tier 2: steel, glass and the parts everything is built from (rods, screws, gears), then crates
    { "id": "forge_steel", "inputs": [ { "item": "iron_ingot", "count": 1 }, { "item": "coal", "count": 1 } ], "outputs": [ { "item": "steel", "count": 1 } ], "ticks": 30, "valueMultiplier": 2.5 },
    { "id": "melt_glass", "inputs": [ { "item": "sand", "count": 2 } ], "outputs": [ { "item": "glass", "count": 1 } ], "ticks": 24, "valueMultiplier": 3 },
    { "id": "make_rod", "inputs": [ { "item": "iron_ingot", "count": 1 } ], "outputs": [ { "item": "iron_rod", "count": 2 } ], "ticks": 16, "valueMultiplier": 1.5 },
    { "id": "make_screw", "inputs": [ { "item": "iron_rod", "count": 1 } ], "outputs": [ { "item": "screw", "count": 3 } ], "ticks": 12, "valueMultiplier": 1.8 },
    { "id": "make_gear", "inputs": [ { "item": "iron_plate", "count": 2 } ], "outputs": [ { "item": "gear", "count": 1 } ], "ticks": 24, "valueMultiplier": 2 },
    { "id": "build_crate", "inputs": [ { "item": "plank", "count": 4 }, { "item": "iron_plate", "count": 2 }, { "item": "screw", "count": 4 } ], "outputs": [ { "item": "crate", "count": 1 } ], "ticks": 40, "valueMultiplier": 2.6 },
    // Tier 3: plastic, cables and frames; toys are boxed in a crate
    { "id": "refine_plastic", "inputs": [ { "item": "crude_oil", "count": 1 } ], "outputs": [ { "item": "plastic", "count": 2 } ], "ticks": 30, "valueMultiplier": 2 },
    { "id": "make_cable", "inputs": [ { "item": "copper_wire", "count": 2 }, { "item": "plastic", "count": 1 } ], "outputs": [ { "item": "cable", "count": 1 } ], "ticks": 30, "valueMultiplier": 2.6 },
    { "id": "make_frame", "inputs": [ { "item": "steel", "count": 2 }, { "item": "iron_rod", "count": 4 }, { "item": "screw", "count": 4 } ], "outputs": [ { "item": "frame", "count": 1 } ], "ticks": 50, "valueMultiplier": 2.8 },
    { "id": "make_toy", "inputs": [ { "item": "plastic", "count": 2 }, { "item": "gear", "count": 2 }, { "item": "crate", "count": 1 } ], "outputs": [ { "item": "toy", "count": 1 } ], "ticks": 40, "valueMultiplier": 3 },
    // Tier 4: electronics: circuit boards, batteries (they need circuits) and motors (they need batteries)
    { "id": "smelt_gold", "inputs": [ { "item": "gold_ore", "count": 1 } ], "outputs": [ { "item": "gold_ingot", "count": 1 } ], "ticks": 24, "valueMultiplier": 2.5 },
    { "id": "make_circuit", "inputs": [ { "item": "copper_wire", "count": 3 }, { "item": "plastic", "count": 1 }, { "item": "glass", "count": 1 } ], "outputs": [ { "item": "circuit", "count": 1 } ], "ticks": 40, "valueMultiplier": 3.5 },
    { "id": "make_battery", "inputs": [ { "item": "circuit", "count": 1 }, { "item": "cable", "count": 1 }, { "item": "iron_plate", "count": 2 } ], "outputs": [ { "item": "battery", "count": 1 } ], "ticks": 50, "valueMultiplier": 3 },
    { "id": "make_motor", "inputs": [ { "item": "steel", "count": 2 }, { "item": "gear", "count": 2 }, { "item": "battery", "count": 1 } ], "outputs": [ { "item": "motor", "count": 1 } ], "ticks": 60, "valueMultiplier": 3.5 },
    { "id": "make_jewelry", "inputs": [ { "item": "gold_ingot", "count": 2 }, { "item": "glass", "count": 1 } ], "outputs": [ { "item": "jewelry", "count": 1 } ], "ticks": 50, "valueMultiplier": 3.5 },
    // Tier 5-7: robots are built on a toy body; drones need a robot; satellites need a drone
    { "id": "make_robot", "inputs": [ { "item": "toy", "count": 1 }, { "item": "motor", "count": 2 }, { "item": "circuit", "count": 2 } ], "outputs": [ { "item": "robot", "count": 1 } ], "ticks": 80, "valueMultiplier": 4.5 },
    { "id": "make_aluminium", "inputs": [ { "item": "bauxite", "count": 2 }, { "item": "coal", "count": 1 } ], "outputs": [ { "item": "aluminium", "count": 1 } ], "ticks": 40, "valueMultiplier": 3 },
    { "id": "make_drone", "inputs": [ { "item": "frame", "count": 1 }, { "item": "aluminium", "count": 2 }, { "item": "robot", "count": 1 } ], "outputs": [ { "item": "drone", "count": 1 } ], "ticks": 90, "valueMultiplier": 3.2 },
    { "id": "make_fuel", "inputs": [ { "item": "crude_oil", "count": 2 }, { "item": "coal", "count": 1 } ], "outputs": [ { "item": "rocket_fuel", "count": 1 } ], "ticks": 40, "valueMultiplier": 4 },
    { "id": "make_satellite", "inputs": [ { "item": "drone", "count": 1 }, { "item": "jewelry", "count": 2 }, { "item": "rocket_fuel", "count": 2 } ], "outputs": [ { "item": "satellite", "count": 1 } ], "ticks": 120, "valueMultiplier": 2.0 },
    // Deep-space probes (content drop, 4.6.0): an optional final use for satellites, with a modest value gain.
    { "id": "make_space_probe", "inputs": [ { "item": "satellite", "count": 1 }, { "item": "circuit", "count": 2 }, { "item": "rocket_fuel", "count": 2 } ], "outputs": [ { "item": "space_probe", "count": 1 } ], "ticks": 160, "valueMultiplier": 1.5 },
    // Orbital tier (content drop, 4.13.0): titanium like aluminium, panels from glass, circuits and aluminium,
    // a module crewed by a robot, and a station from two modules, a satellite and fuel to lift it.
    { "id": "make_titanium", "inputs": [ { "item": "titanium_ore", "count": 2 }, { "item": "coal", "count": 1 } ], "outputs": [ { "item": "titanium", "count": 1 } ], "ticks": 40, "valueMultiplier": 3.5 },
    { "id": "make_solar_panel", "inputs": [ { "item": "glass", "count": 2 }, { "item": "circuit", "count": 1 }, { "item": "aluminium", "count": 1 } ], "outputs": [ { "item": "solar_panel", "count": 1 } ], "ticks": 60, "valueMultiplier": 3 },
    { "id": "make_habitat_module", "inputs": [ { "item": "titanium", "count": 4 }, { "item": "solar_panel", "count": 2 }, { "item": "robot", "count": 1 } ], "outputs": [ { "item": "habitat_module", "count": 1 } ], "ticks": 120, "valueMultiplier": 4 },
    { "id": "make_orbital_station", "inputs": [ { "item": "habitat_module", "count": 2 }, { "item": "satellite", "count": 1 }, { "item": "rocket_fuel", "count": 4 } ], "outputs": [ { "item": "orbital_station", "count": 1 } ], "ticks": 200, "valueMultiplier": 3.5 },
    // Fusion tier (content drop, 4.25.0): lithium dried out of brine, superconductors that give gold ingots and
    // titanium a second use, fusion cells that pull batteries through the whole electronics line, and a starship:
    // an orbital station with fusion cells to drive it and a titanium hull, so stations stop being a dead end.
    { "id": "make_lithium", "inputs": [ { "item": "lithium_brine", "count": 3 } ], "outputs": [ { "item": "lithium", "count": 1 } ], "ticks": 40, "valueMultiplier": 3 },
    { "id": "make_superconductor", "inputs": [ { "item": "gold_ingot", "count": 2 }, { "item": "titanium", "count": 1 }, { "item": "cable", "count": 2 } ], "outputs": [ { "item": "superconductor", "count": 1 } ], "ticks": 60, "valueMultiplier": 3.5 },
    { "id": "make_fusion_cell", "inputs": [ { "item": "lithium", "count": 4 }, { "item": "superconductor", "count": 2 }, { "item": "battery", "count": 2 } ], "outputs": [ { "item": "fusion_cell", "count": 1 } ], "ticks": 100, "valueMultiplier": 3.5 },
    { "id": "make_starship", "inputs": [ { "item": "orbital_station", "count": 1 }, { "item": "fusion_cell", "count": 6 }, { "item": "titanium", "count": 4 } ], "outputs": [ { "item": "starship", "count": 1 } ], "ticks": 300, "valueMultiplier": 3.5 },
    // Byproduct trial. A craft's value is split evenly over all its output units, so both recipes are
    // tuned to make exactly what the plain recipes make: plastic $1 and steel $7.5, and tar $1 like the
    // coal it replaces. Cracking gives less plastic per oil (1.5 against 2) but works through oil 50%
    // faster, and its tar saves a coal drill. A refinery never cracks unless the player chooses it; a
    // blast furnace left on automatic burns any tar it is holding before it touches its coal, so a
    // player who feeds it both does not bank tar for ever and stall the splitter that sorts it out.
    { "id": "crack_oil", "inputs": [ { "item": "crude_oil", "count": 2 } ], "outputs": [ { "item": "plastic", "count": 3 }, { "item": "tar", "count": 1 } ], "ticks": 40, "valueMultiplier": 2 },
    { "id": "forge_steel_tar", "inputs": [ { "item": "iron_ingot", "count": 1 }, { "item": "tar", "count": 1 } ], "outputs": [ { "item": "steel", "count": 1 } ], "ticks": 30, "valueMultiplier": 2.5 },

    // Research trial. Value multiplier 0.5: a pack sells for the average of its two parts, so a depot never
    // earns more from a belt of packs than from a belt of plates or wire, and selling packs is never a reason
    // to make them. (At 1 it did: two parts' worth in one unit wins wherever depots are the limit.)
    { "id": "pack_1", "inputs": [ { "item": "iron_plate", "count": 1 }, { "item": "copper_wire", "count": 1 } ], "outputs": [ { "item": "science_1", "count": 1 } ], "ticks": 40, "valueMultiplier": 0.5 },

    // Research slice 2 (4.4.0). Half the parts' value keeps this pack from becoming a depot product.
    { "id": "pack_2", "inputs": [ { "item": "steel", "count": 1 }, { "item": "gear", "count": 1 }, { "item": "screw", "count": 2 } ], "outputs": [ { "item": "science_2", "count": 1 } ], "ticks": 60, "valueMultiplier": 0.5 },

    // Industrial exports (content drop, 4.7.0): sellable side products that give rods, screws,
    // gears and cables another use without changing any existing machine's automatic choices.
    { "id": "make_toolkit", "inputs": [ { "item": "gear", "count": 2 }, { "item": "iron_rod", "count": 2 }, { "item": "screw", "count": 4 } ], "outputs": [ { "item": "toolkit", "count": 1 } ], "ticks": 50, "valueMultiplier": 2.0 },
    { "id": "make_industrial_pump", "inputs": [ { "item": "frame", "count": 1 }, { "item": "cable", "count": 2 }, { "item": "steel", "count": 2 } ], "outputs": [ { "item": "industrial_pump", "count": 1 } ], "ticks": 70, "valueMultiplier": 2.0 },

    // Consumer goods. Chairs use the logs that sit idle until crates; lanterns the coal (through steel)
    // that sits idle until steel is needed; phones and cars are a second product beside motors and robots;
    // airliners give Aerospace, the longest wait for the next tier, a second product as good as drones.
    // Three ingredients at most, like every recipe, so each has a side of the machine. Cars and airliners
    // multiply more than robots and drones (5.5 against 4.5 and 3.2) because chairs, tires and lanterns
    // are few steps from the ore and carry little value into them; `balance tiers` shows each good
    // taking a real share of its tier's income, not all of it.
    { "id": "make_chair", "inputs": [ { "item": "plank", "count": 4 }, { "item": "iron_plate", "count": 1 } ], "outputs": [ { "item": "chair", "count": 1 } ], "ticks": 40, "valueMultiplier": 1.8 },
    { "id": "make_lantern", "inputs": [ { "item": "glass", "count": 1 }, { "item": "steel", "count": 1 }, { "item": "copper_wire", "count": 2 } ], "outputs": [ { "item": "lantern", "count": 1 } ], "ticks": 40, "valueMultiplier": 2.2 },
    { "id": "make_tire", "inputs": [ { "item": "plastic", "count": 3 }, { "item": "steel", "count": 1 } ], "outputs": [ { "item": "tire", "count": 1 } ], "ticks": 30, "valueMultiplier": 2.2 },
    { "id": "make_phone", "inputs": [ { "item": "circuit", "count": 1 }, { "item": "battery", "count": 1 }, { "item": "glass", "count": 1 } ], "outputs": [ { "item": "phone", "count": 1 } ], "ticks": 50, "valueMultiplier": 3 },
    { "id": "make_car", "inputs": [ { "item": "motor", "count": 2 }, { "item": "tire", "count": 4 }, { "item": "chair", "count": 2 } ], "outputs": [ { "item": "car", "count": 1 } ], "ticks": 80, "valueMultiplier": 5 },
    { "id": "make_airliner", "inputs": [ { "item": "frame", "count": 2 }, { "item": "motor", "count": 2 }, { "item": "phone", "count": 2 } ], "outputs": [ { "item": "airliner", "count": 1 } ], "ticks": 120, "valueMultiplier": 5.5 },

    // Home appliances (4.24.0). Kettles give cable a first use outside batteries and pumps, televisions put
    // glass and circuits into a mid-price good, washing machines are the cheap use of a motor next to cars
    // and robots, and e-bikes the second use of aluminium and a third of batteries. Each is worth less per item
    // and pays back slower than its tier's main product, so where depots are the limit (`balance tiers`) the
    // main line still wins: appliances are variety and a place for spare parts, never a better way to play.
    { "id": "make_kettle", "inputs": [ { "item": "steel", "count": 1 }, { "item": "cable", "count": 1 }, { "item": "plastic", "count": 2 } ], "outputs": [ { "item": "kettle", "count": 1 } ], "ticks": 30, "valueMultiplier": 3.2 },
    { "id": "make_television", "inputs": [ { "item": "glass", "count": 2 }, { "item": "circuit", "count": 2 }, { "item": "plastic", "count": 4 } ], "outputs": [ { "item": "television", "count": 1 } ], "ticks": 50, "valueMultiplier": 6 },
    { "id": "make_washing_machine", "inputs": [ { "item": "motor", "count": 1 }, { "item": "steel", "count": 4 }, { "item": "iron_plate", "count": 4 } ], "outputs": [ { "item": "washing_machine", "count": 1 } ], "ticks": 60, "valueMultiplier": 3.5 },
    { "id": "make_ebike", "inputs": [ { "item": "aluminium", "count": 2 }, { "item": "motor", "count": 2 }, { "item": "battery", "count": 2 } ], "outputs": [ { "item": "ebike", "count": 1 } ], "ticks": 80, "valueMultiplier": 10 },

    // Late exports (4.26.0, repriced 4.28.0). Each is built on the tier before's main product (rover: a drone and
    // a robot; suit and maglev: habitat modules), so it carries that tier's value and stays worth selling when
    // values jump per tier. Per ore (see `balance items`) each earns about half to two thirds of its tier's main
    // product: a real second line, never the better one. Tests in LateExportsTests keep it that way.
    { "id": "make_rover", "inputs": [ { "item": "drone", "count": 1 }, { "item": "robot", "count": 1 }, { "item": "battery", "count": 4 } ], "outputs": [ { "item": "rover", "count": 1 } ], "ticks": 120, "valueMultiplier": 3.5 },
    { "id": "make_space_suit", "inputs": [ { "item": "habitat_module", "count": 1 }, { "item": "titanium", "count": 4 }, { "item": "battery", "count": 2 } ], "outputs": [ { "item": "space_suit", "count": 1 } ], "ticks": 90, "valueMultiplier": 4.2 },
    { "id": "make_maglev", "inputs": [ { "item": "habitat_module", "count": 2 }, { "item": "superconductor", "count": 8 }, { "item": "fusion_cell", "count": 1 } ], "outputs": [ { "item": "maglev", "count": 1 } ], "ticks": 150, "valueMultiplier": 20 },

    // Bulk machines (idea B11, content drop 4.22.0): delete every entry marked "Bulk machines" to remove them.
    // Twice the input and output of the plain recipe in 1.5 times the time, at the same value multiplier, so
    // an item is worth the same whichever machine made it; a bulk machine is a third faster, not richer.
    { "id": "bulk_smelt_iron", "inputs": [ { "item": "iron_ore", "count": 2 } ], "outputs": [ { "item": "iron_ingot", "count": 2 } ], "ticks": 24, "valueMultiplier": 2 },
    { "id": "bulk_smelt_copper", "inputs": [ { "item": "copper_ore", "count": 2 } ], "outputs": [ { "item": "copper_ingot", "count": 2 } ], "ticks": 24, "valueMultiplier": 2 },
    { "id": "bulk_smelt_gold", "inputs": [ { "item": "gold_ore", "count": 2 } ], "outputs": [ { "item": "gold_ingot", "count": 2 } ], "ticks": 36, "valueMultiplier": 2.5 },
    { "id": "bulk_press_plate", "inputs": [ { "item": "iron_ingot", "count": 2 } ], "outputs": [ { "item": "iron_plate", "count": 2 } ], "ticks": 24, "valueMultiplier": 2 },
    { "id": "bulk_draw_wire", "inputs": [ { "item": "copper_ingot", "count": 2 } ], "outputs": [ { "item": "copper_wire", "count": 4 } ], "ticks": 24, "valueMultiplier": 2 },
    { "id": "bulk_forge_steel", "inputs": [ { "item": "iron_ingot", "count": 2 }, { "item": "coal", "count": 2 } ], "outputs": [ { "item": "steel", "count": 2 } ], "ticks": 45, "valueMultiplier": 2.5 }
  ],

  "buildings": [
    // ---- Logistics -----------------------------------------------------------------
    // Throughput = speed × 20 / spacing items per second. Speed is capped at spacing, so nothing
    // moves more than one item per tick (20/s). Belts: 4/s at level 1, 20/s at level 9.
    // Splitters match belts. A merger runs slower than a belt (3.33/s at level 1) and leaves a wider gap
    // between items (spacing 300), but grows faster and reaches the 20/s cap at level 7: joining lines is
    // a real gate until it is levelled up.
    {
      "id": "conveyor", "name": "Conveyor", "behavior": "conveyor", "cost": 10, "category": "logistics", "tier": 0,
      "group": "belt", "replaces": [ "belt" ],
      "ports": [
        { "kind": "in", "side": "back" }, { "kind": "in", "side": "left" }, { "kind": "in", "side": "right" },
        { "kind": "out", "side": "front" }
      ],
      "upgrade": { "maxLevel": 9, "speedPerLevel": 0.5, "costFactor": 3, "costGrowth": 2 },
      "params": { "speed": 50, "spacing": 250 },
      "meta": { "model": "belt", "glyph": "belt", "description": "Moves items in a straight line and curves when fed from one side. It does not take items from a belt beside it: use a merger to join lines. Drag to lay a line; dragging across another belt bridges over it." }
    },
    {
      // Occupies its cell and the one above; enters low at the back, leaves one level up at the front.
      "id": "ramp_up", "name": "Ramp Up", "behavior": "conveyor", "cost": 25, "category": "logistics", "tier": 0,
      "group": "ramp", "replaces": [ "belt", "ramp" ],
      "footprint": [ [0, 0, 0], [0, 0, 1] ],
      "ports": [
        { "kind": "in", "side": "back", "cell": [0, 0, 0] },
        { "kind": "out", "side": "front", "cell": [0, 0, 1] }
      ],
      "upgrade": { "maxLevel": 9, "speedPerLevel": 0.5, "costFactor": 3, "costGrowth": 2 },
      "params": { "speed": 50, "spacing": 250 },
      "meta": { "model": "ramp", "glyph": "U", "description": "Lifts items one level. Belts one level up are bridges: other lines pass underneath." }
    },
    {
      "id": "ramp_down", "name": "Ramp Down", "behavior": "conveyor", "cost": 25, "category": "logistics", "tier": 0,
      "group": "ramp", "replaces": [ "belt", "ramp" ],
      "footprint": [ [0, 0, 0], [0, 0, 1] ],
      "ports": [
        { "kind": "in", "side": "back", "cell": [0, 0, 1] },
        { "kind": "out", "side": "front", "cell": [0, 0, 0] }
      ],
      "upgrade": { "maxLevel": 9, "speedPerLevel": 0.5, "costFactor": 3, "costGrowth": 2 },
      "params": { "speed": 50, "spacing": 250 },
      "meta": { "model": "ramp", "glyph": "D", "description": "Brings items down one level. Placed on the ground it lands on the ground." }
    },
    {
      "id": "splitter", "name": "Splitter", "behavior": "router", "cost": 200, "category": "logistics", "tier": 0,
      "group": "hub", "replaces": [ "belt", "hub" ],
      "ports": [
        { "kind": "in", "side": "back" },
        { "kind": "out", "side": "front" }, { "kind": "out", "side": "left" }, { "kind": "out", "side": "right" }
      ],
      "upgrade": { "maxLevel": 9, "speedPerLevel": 0.5, "costFactor": 1.5, "costGrowth": 2.2 },
      "params": { "speed": 50, "spacing": 250 },
      "meta": { "model": "splitter", "glyph": "Y", "accent": "#4fb6ff", "description": "Distributes items evenly over up to three outputs; skips blocked ones. Drop it onto a belt." }
    },
    {
      "id": "merger", "name": "Merger", "behavior": "router", "cost": 200, "category": "logistics", "tier": 0,
      "group": "hub", "replaces": [ "belt", "hub" ],
      "ports": [
        { "kind": "in", "side": "back" }, { "kind": "in", "side": "left" }, { "kind": "in", "side": "right" },
        { "kind": "out", "side": "front" }
      ],
      "upgrade": { "maxLevel": 7, "speedPerLevel": 0.833, "costFactor": 1.5, "costGrowth": 2.2 },
      "params": { "speed": 50, "spacing": 300 },
      "meta": { "model": "merger", "glyph": "X", "accent": "#ffb347", "description": "Joins up to three lines fairly into one. It runs slower than a belt and spaces items wider, so it caps how much gets through: upgrade it when lines back up. Drop it onto a belt." }
    },

    // ---- Production ----------------------------------------------------------------
    {
      "id": "iron_miner", "name": "Iron Drill", "behavior": "miner", "cost": 30, "category": "production", "tier": 0,
      "group": "extractor", "replaces": [ "extractor" ],
      "limit": { "base": 4, "perTier": 2 },
      "ports": [ { "kind": "out", "side": "front" } ],
      "params": { "item": "iron_ore", "interval": 20, "amount": 1 },
      "meta": { "model": "drill", "accent": "#8d95a3", "glyph": "M", "description": "Extracts iron ore: 1 per second. Raw ore sells cheaply: smelt it first." }
    },
    {
