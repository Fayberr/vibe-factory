      "meta": { "model": "treefarm", "accent": "#4f9d4a", "glyph": "L", "description": "Grows and fells trees: 1 log every 1.2 s." }
    },
    {
      "id": "coal_miner", "name": "Coal Drill", "behavior": "miner", "cost": 450, "category": "production", "tier": 2,
      "group": "extractor", "replaces": [ "extractor" ],
      "limit": { "base": 3, "perTier": 2 },
      "ports": [ { "kind": "out", "side": "front" } ],
      "params": { "item": "coal", "interval": 24, "amount": 1 },
      "meta": { "model": "drill", "accent": "#3b3f47", "glyph": "K", "description": "Extracts coal: 1 every 1.2 s." }
    },
    {
      "id": "sand_quarry", "name": "Sand Quarry", "behavior": "miner", "cost": 400, "category": "production", "tier": 2,
      "group": "extractor", "replaces": [ "extractor" ],
      "limit": { "base": 3, "perTier": 2 },
      "ports": [ { "kind": "out", "side": "front" } ],
      "params": { "item": "sand", "interval": 16, "amount": 1 },
      "meta": { "model": "quarry", "accent": "#e0b862", "glyph": "Q", "description": "Sifts sand: 1 every 0.8 s." }
    },
    {
      "id": "oil_pump", "name": "Oil Pump", "behavior": "miner", "cost": 6000, "category": "production", "tier": 3,
      "group": "extractor", "replaces": [ "extractor" ],
      "limit": { "base": 2, "perTier": 2 },
      "ports": [ { "kind": "out", "side": "front" } ],
      "params": { "item": "crude_oil", "interval": 40, "amount": 1 },
      "meta": { "model": "pump", "accent": "#e2513a", "glyph": "O", "description": "Pumps crude oil: 1 barrel every 2 s." }
    },
    {
      "id": "bauxite_mine", "name": "Bauxite Mine", "behavior": "miner", "cost": 1e7, "category": "production", "tier": 6,
      "group": "extractor", "replaces": [ "extractor" ],
      "limit": { "base": 2, "perTier": 2 },
      "ports": [ { "kind": "out", "side": "front" } ],
      "params": { "item": "bauxite", "interval": 40, "amount": 1 },
      "meta": { "model": "drill", "accent": "#c8795a", "glyph": "A", "description": "Mines bauxite, the ore of aluminium: 1 every 2 s." }
    },
    {
      "id": "gold_miner", "name": "Gold Drill", "behavior": "miner", "cost": 7e4, "category": "production", "tier": 4,
      "group": "extractor", "replaces": [ "extractor" ],
      "limit": { "base": 2, "perTier": 2 },
      "ports": [ { "kind": "out", "side": "front" } ],
      "params": { "item": "gold_ore", "interval": 40, "amount": 1 },
      "meta": { "model": "drill", "accent": "#f2c14e", "glyph": "G", "description": "Extracts gold ore: 1 every 2 s." }
    },

    // ---- Processing ------------------------------------------------------------------
    {
      "id": "smelter", "name": "Smelter", "behavior": "processor", "cost": 60, "category": "processing", "tier": 0,
      "group": "machine", "replaces": [ "machine", "belt" ],
      "ports": [ { "kind": "in", "side": "back" }, { "kind": "in", "side": "left" }, { "kind": "in", "side": "right" }, { "kind": "out", "side": "front" } ],
      "params": { "recipes": [ "smelt_iron", "smelt_copper", "smelt_gold" ], "inputCapacity": 8, "outputCapacity": 8 },
      "meta": { "model": "furnace", "accent": "#ff7a2f", "glyph": "S", "description": "Smelts iron, copper or gold ore into ingots (2× value)." }
    },
    {
      // An in-line upgrader is a conveyor with an effect: ×1.5 value, once per item.
      "id": "polisher", "name": "Polisher", "behavior": "conveyor", "cost": 150, "category": "processing", "tier": 1,
      "group": "belt", "replaces": [ "belt" ],
      "upgrade": { "maxLevel": 10, "speedPerLevel": 0.15, "valuePerLevel": 0.1, "costFactor": 1.5, "costGrowth": 1.8 },
      "ports": [ { "kind": "in", "side": "back" }, { "kind": "out", "side": "front" } ],
      "params": { "speed": 100, "spacing": 250, "effect": { "tag": "polished", "valueMultiplier": 1.5, "once": true } },
      "meta": { "model": "polisher", "accent": "#35d0c9", "glyph": "P", "description": "In-line upgrader: ×1.5 value, once per item, paid when the item is sold. Crafting values its inputs at the plain rate, so polish what you sell, not what you feed a machine. Drop it onto a belt." }
    },
    {
      "id": "sawmill", "name": "Sawmill", "behavior": "processor", "cost": 120, "category": "processing", "tier": 1,
      "group": "machine", "replaces": [ "machine", "belt" ],
      "ports": [ { "kind": "in", "side": "back" }, { "kind": "in", "side": "left" }, { "kind": "in", "side": "right" }, { "kind": "out", "side": "front" } ],
      "params": { "recipes": [ "saw_planks" ], "inputCapacity": 8, "outputCapacity": 8 },
      "meta": { "model": "sawmill", "accent": "#c98a45", "glyph": "W", "description": "Saws each log into 2 planks." }
    },
    {
      "id": "press", "name": "Press", "behavior": "processor", "cost": 250, "category": "processing", "tier": 1,
      "group": "machine", "replaces": [ "machine", "belt" ],
      "ports": [ { "kind": "in", "side": "back" }, { "kind": "in", "side": "left" }, { "kind": "in", "side": "right" }, { "kind": "out", "side": "front" } ],
      "params": { "recipes": [ "press_plate", "draw_wire" ], "inputCapacity": 8, "outputCapacity": 8 },
      "meta": { "model": "press", "accent": "#5b8def", "glyph": "R", "description": "Presses iron ingots into plates and draws copper ingots into wire." }
    },
    {
      "id": "blast_furnace", "name": "Blast Furnace", "behavior": "processor", "cost": 1500, "category": "processing", "tier": 2,
      "group": "machine", "replaces": [ "machine", "belt" ],
      "ports": [ { "kind": "in", "side": "back" }, { "kind": "in", "side": "left" }, { "kind": "in", "side": "right" }, { "kind": "out", "side": "front" } ],
      "params": { "recipes": [ "forge_steel", "forge_steel_tar" ], "inputCapacity": 8, "outputCapacity": 8 }, // the second recipe is the byproduct trial
      "meta": { "model": "forge", "accent": "#ff5a2a", "glyph": "B", "description": "Fuses iron ingots with coal into steel (2.5× value). Left alone it burns any tar it is given before its coal, so a cracking line's byproduct need not be wasted." }
    },
    {
      "id": "glassworks", "name": "Glassworks", "behavior": "processor", "cost": 1000, "category": "processing", "tier": 2,
      "group": "machine", "replaces": [ "machine", "belt" ],
