      "group": "extractor", "replaces": [ "extractor" ],
      "limit": { "base": 3, "perTier": 2 },
      "ports": [ { "kind": "out", "side": "front" } ],
      "params": { "item": "copper_ore", "interval": 30, "amount": 1 },
      "meta": { "model": "drill", "accent": "#e07a3a", "glyph": "C", "description": "Extracts copper ore: 1 every 1.5 s." }
    },
