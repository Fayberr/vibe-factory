      "params": { "recipes": [ "pack_1", "pack_2" ], "inputCapacity": 8, "outputCapacity": 8 },
      "meta": { "model": "assembler", "accent": "#8f7cff", "glyph": "B", "description": "Makes Basic and Advanced Science Packs from factory parts. Belt the packs into a Lab." }
    },
    {
      "id": "lab", "name": "Lab", "behavior": "lab", "cost": 500, "category": "research", "tier": 1,
      "group": "machine", "replaces": [ "machine", "belt" ],
      "ports": [ { "kind": "in", "side": "back" }, { "kind": "in", "side": "left" }, { "kind": "in", "side": "right" } ],
