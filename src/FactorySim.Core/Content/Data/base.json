// Base content pack. Everything here is data: tweak numbers, add machines that
// reuse existing behaviors, or layer another pack on top (later packs override by id).
//
// Units: 20 ticks = 1 second. Conveyor tile = 1000 units.
// Ports: "side" is relative to the building facing north; "cell" is a footprint cell.
// Buildings: "tier" gates unlocking; "group"/"replaces" control placing on top of other
// buildings (a splitter can be dropped into a belt line, a belt never replaces a machine);
// "upgrade" overrides the behavior's default per-building level track; "limit" caps how
// many can be built (base, plus perTier for every "every" tiers unlocked after the building's own).
// Items marked "raw" sell at a quarter of their value: processing is what pays.
// There are no global upgrades: every building is levelled on its own.
// "meta" is ignored by the simulation; frontends use it:
//   model   procedural 3D model in the Godot client; accent = highlight colour
//   glyph   ASCII view; description = build menu text; items: color + shape (mesh).
{
  "tiers": [
    { "name": "Basics",         "description": "Drill, smelt, sell.",                          "cost": 0,     "requiredEarnings": 0,     "plotSize": 24 },
    { "name": "Workshop",       "description": "Copper, wood, presses and polishers.",         "cost": 500,   "requiredEarnings": 750,   "plotSize": 30 },
    { "name": "Industry",       "description": "Coal, steel, sand, glass and crates.",         "cost": 6000,  "requiredEarnings": 1e4,   "plotSize": 36 },
    { "name": "Petrochemicals", "description": "Oil, plastic, toys and export terminals.",     "cost": 8e4,   "requiredEarnings": 1.5e5, "plotSize": 44 },
    { "name": "Electronics",    "description": "Gold, circuits, motors and jewelry.",          "cost": 1e6,   "requiredEarnings": 2e6,   "plotSize": 52 },
    { "name": "Robotics",       "description": "Robots from motors, circuits and glass.",      "cost": 1.5e7, "requiredEarnings": 3e7,   "plotSize": 64 },
    { "name": "Aerospace",      "description": "Bauxite, aluminium and drones.",               "cost": 1.2e8, "requiredEarnings": 2.5e8, "plotSize": 72 },
    { "name": "Space",          "description": "Rocket fuel and satellites.",                  "cost": 2e9,   "requiredEarnings": 4e9,   "plotSize": 80 }
  ],

