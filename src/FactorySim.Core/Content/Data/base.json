  "recipes": [
    { "id": "smelt_iron",     "inputs": [ { "item": "iron_ore", "count": 1 } ],   "outputs": [ { "item": "iron_ingot", "count": 1 } ],   "ticks": 16, "valueMultiplier": 2 },
    { "id": "smelt_copper",   "inputs": [ { "item": "copper_ore", "count": 1 } ], "outputs": [ { "item": "copper_ingot", "count": 1 } ], "ticks": 16, "valueMultiplier": 2 },
    { "id": "smelt_gold",     "inputs": [ { "item": "gold_ore", "count": 1 } ],   "outputs": [ { "item": "gold_ingot", "count": 1 } ],   "ticks": 24, "valueMultiplier": 2.5 },
    { "id": "saw_planks",     "inputs": [ { "item": "log", "count": 1 } ],        "outputs": [ { "item": "plank", "count": 2 } ],        "ticks": 20, "valueMultiplier": 1.8 },
    { "id": "press_plate",    "inputs": [ { "item": "iron_ingot", "count": 1 } ], "outputs": [ { "item": "iron_plate", "count": 1 } ],   "ticks": 16, "valueMultiplier": 1.5 },
