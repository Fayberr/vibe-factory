    { "id": "make_circuit",   "inputs": [ { "item": "copper_wire", "count": 2 }, { "item": "plastic", "count": 1 } ], "outputs": [ { "item": "circuit", "count": 1 } ], "ticks": 40, "valueMultiplier": 3 },
    { "id": "make_motor",     "inputs": [ { "item": "steel", "count": 1 }, { "item": "circuit", "count": 1 }, { "item": "copper_wire", "count": 2 } ], "outputs": [ { "item": "motor", "count": 1 } ], "ticks": 60, "valueMultiplier": 2.5 },
    { "id": "make_jewelry",   "inputs": [ { "item": "gold_ingot", "count": 1 }, { "item": "glass", "count": 1 } ], "outputs": [ { "item": "jewelry", "count": 1 } ], "ticks": 50, "valueMultiplier": 3 },
    { "id": "make_robot",     "inputs": [ { "item": "motor", "count": 1 }, { "item": "circuit", "count": 1 }, { "item": "glass", "count": 1 } ], "outputs": [ { "item": "robot", "count": 1 } ], "ticks": 80, "valueMultiplier": 4 },
    { "id": "make_aluminium", "inputs": [ { "item": "bauxite", "count": 2 }, { "item": "coal", "count": 1 } ], "outputs": [ { "item": "aluminium", "count": 1 } ], "ticks": 40, "valueMultiplier": 3 },
