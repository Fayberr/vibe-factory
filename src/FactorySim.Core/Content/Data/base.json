    // ---- Research trial ------------------------------------------------------------------
    // A bench makes packs, a lab banks them (one every 4 seconds at level 1), the Research window spends
    // the bank. Labs take packs whether or not anything is being bought, so they never back up a belt
    // for want of a choice.
    {
      "id": "science_bench", "name": "Science Bench", "behavior": "processor", "cost": 500, "category": "research", "tier": 1,
      "group": "machine", "replaces": [ "machine", "belt" ],
      "ports": [ { "kind": "in", "side": "back" }, { "kind": "in", "side": "left" }, { "kind": "in", "side": "right" }, { "kind": "out", "side": "front" } ],
