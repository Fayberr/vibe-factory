// Base content pack. Everything here is data: tweak numbers, add machines that
// reuse existing behaviors, or layer another pack on top (later packs override by id).
//
// Units: 20 ticks = 1 second. Conveyor tile = 1000 units.
// Ports: "side" is relative to the building facing north; "cell" is a footprint cell.
// Buildings: "tier" gates unlocking; "group"/"replaces" control placing on top of other
// buildings (a splitter can be dropped into a belt line, a belt never replaces a machine);
// "upgrade" overrides the behavior's default level-up track.
// "meta" is ignored by the simulation — frontends use it:
//   model   procedural 3D model in the Godot client; accent = highlight colour
//   level   placement height above the ground (1 = bridge level)
//   glyph   ASCII view; description = build menu text; items: color + shape (mesh).
{
  "tiers": [
    { "name": "Basics",         "description": "Drill, smelt, sell.",                         "cost": 0,     "requiredEarnings": 0,     "plotSize": 24 },
    { "name": "Workshop",       "description": "Copper, wood, presses, bridges and polish.",  "cost": 400,   "requiredEarnings": 600,   "plotSize": 30 },
    { "name": "Industry",       "description": "Coal, steel, sand, glass and crates.",        "cost": 5000,  "requiredEarnings": 8000,  "plotSize": 36 },
