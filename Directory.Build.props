<Project>
  <!-- Shared settings for the engine-agnostic projects (core, CLI, tests).
       The Godot client has its own Directory.Build.props so these do not leak into it. -->
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Godot exports build referenced projects (the core) with Configuration=ExportRelease,
         which the SDK doesn't treat as optimized by default. -->
    <Optimize Condition="'$(Configuration)' == 'ExportRelease'">true</Optimize>
  </PropertyGroup>

  <!-- The version comes from the VERSION file at the repository root: one place to bump it, and
       the value compiled into the assemblies is the value in that file. The client stamps it into
       its assembly and shows it in the corner of the screen; CI names the release after it. -->
  <PropertyGroup>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</Version>
  </PropertyGroup>
</Project>
