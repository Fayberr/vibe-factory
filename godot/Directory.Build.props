<Project>
  <!-- Intentionally free of the repository-root Directory.Build.props settings
       (warnings-as-errors, implicit usings): this file stops that import. The version is not one
       of those settings, so it is read here from the same VERSION file at the repository root. -->
  <PropertyGroup>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../VERSION').Trim())</Version>
  </PropertyGroup>
</Project>
